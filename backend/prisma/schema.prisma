// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentSource {
  PAYMENT_LINK
  ORDER
  COMMUNITY_FORM
}

model Payment {
  id                String         @id @default(cuid())
  amount            Int
  currency          String         @default("INR")
  status            PaymentStatus  @default(PENDING)
  source            PaymentSource  @default(PAYMENT_LINK)

  // Customer details
  fullName          String
  email             String
  phone             String

  // Razorpay IDs
  razorpayPaymentId String?        @unique
  razorpayOrderId   String?        @unique
  razorpaySignature String?
  razorpayPaymentLinkId String?
  razorpayRefundId  String?

  // Payment method details
  paymentMethod     String?        // upi, card, netbanking, wallet
  payerVpa          String?        // UPI ID (e.g. user@upi)
  payerAccountType  String?        // savings, current
  bankRrn           String?        // Bank RRN reference number
  description       String?

  // Timestamps
  paidAt            DateTime?
  refundedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Raw JSON from Razorpay webhook for full audit
  rawWebhookPayload Json?

  registration      Registration?

  @@index([email])
  @@index([phone])
  @@index([razorpayPaymentId])
  @@index([status])
}

model Registration {
  id           String   @id @default(cuid())
  paymentId    String   @unique
  userType     String   @default("professional") // student or professional
  fullName     String
  lastName     String?
  email        String
  phone        String
  password     String?
  
  // Student Specific
  collegeName  String?
  courseName   String?
  studyYear    String? // e.g. "3rd Year"
  
  // Professional Specific
  organization String?
  role         String?
  experience   String?
  domain       String? // e.g. "Data Science", "Marketing"
  
  goals        String?
  idCardUrl    String?  // Storage link for the uploaded ID
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([email])
  @@index([phone])
}

model CommunityLead {
  id           String   @id @default(cuid())
  userType     String   @default("professional")
  fullName     String
  lastName     String?
  email        String
  whatsapp     String
  
  // Student Fields
  collegeName  String?
  courseName   String?
  
  // Pro Fields
  organization String?
  role         String?
  experience   String?
  domain       String?

  joinMastermind  Boolean @default(false)
  joinNewsletter  Boolean @default(false)
  source       String   @default("community_panel")
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([whatsapp])
}

model OtpVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
