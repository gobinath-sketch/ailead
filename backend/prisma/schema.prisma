// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentSource {
  PAYMENT_LINK
  ORDER
  COMMUNITY_FORM
}

model Payment {
  id                String         @id @default(cuid())
  amount            Int
  currency          String         @default("INR")
  status            PaymentStatus  @default(PENDING)
  source            PaymentSource  @default(PAYMENT_LINK)

  // Customer details
  fullName          String
  email             String
  phone             String

  // Razorpay IDs
  razorpayPaymentId String?        @unique
  razorpayOrderId   String?        @unique
  razorpaySignature String?
  razorpayPaymentLinkId String?
  razorpayRefundId  String?

  // Payment method details
  paymentMethod     String?        // upi, card, netbanking, wallet
  payerVpa          String?        // UPI ID (e.g. user@upi)
  payerAccountType  String?        // savings, current
  bankRrn           String?        // Bank RRN reference number
  description       String?

  // Timestamps
  paidAt            DateTime?
  refundedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Raw JSON from Razorpay webhook for full audit
  rawWebhookPayload Json?

  registration      Registration?

  @@index([email])
  @@index([phone])
  @@index([razorpayPaymentId])
  @@index([status])
}

model Registration {
  id           String   @id @default(cuid())
  paymentId    String   @unique
  fullName     String
  email        String
  phone        String
  organization String?
  role         String?
  goals        String?
  experience   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([email])
  @@index([phone])
}

model CommunityLead {
  id           String   @id @default(cuid())
  fullName     String
  email        String
  whatsapp     String
  role         String?
  experience   String?
  joinMastermind  Boolean @default(false)
  joinNewsletter  Boolean @default(false)
  source       String   @default("community_panel")
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([whatsapp])
}
